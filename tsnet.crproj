<Project DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{F8D39348-69E4-46FA-A604-AD6521A788BA}</ProjectGuid>
    <CrustSdkPath Condition="'$(CrustSdkPath)' == '' and '$(CRUST_SDK_PATH)' != ''">$(CRUST_SDK_PATH)</CrustSdkPath>
    <CrustSdkPath Condition="'$(CrustSdkPath)' == '' and Exists('$(MSBuildThisFileDirectory)../crust/editors/msbuild/Crust.props')">$(MSBuildThisFileDirectory)../crust/editors/msbuild</CrustSdkPath>
  </PropertyGroup>
  <Import Project="$(CrustSdkPath)/Crust.props" />
  <ItemGroup>
    <None Remove="artifacts/**" />
    <Compile Remove="artifacts/**" />
  </ItemGroup>
  <PropertyGroup>
    <CrustTarget>tsnetc</CrustTarget>
    <CrustRunArguments>&quot;$(MSBuildProjectDirectory)/examples/structural.ts&quot; &quot;$(MSBuildProjectDirectory)/target/demo.dll&quot;</CrustRunArguments>
    <CrustRunWorkingDirectory>$(MSBuildProjectDirectory)</CrustRunWorkingDirectory>
  </PropertyGroup>
  <Import Project="$(CrustSdkPath)/Crust.targets" />
  <Target Name="BuildMetadataWriter" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/scripts/native-frontend.ps1&quot;" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/scripts/build-metadata-writer.ps1&quot;" />
  </Target>
  <Target Name="PrepareMetadataWriter" BeforeTargets="_CrustReadProject" Condition="'$(DesignTimeBuild)' != 'true' and (!Exists('$(MSBuildProjectDirectory)/artifacts/metadata-writer/Tsnet.Metadata.lib') or !Exists('$(MSBuildProjectDirectory)/artifacts/native-frontend/tsbridge.lib'))">
    <CallTarget Targets="BuildMetadataWriter" />
  </Target>
</Project>
